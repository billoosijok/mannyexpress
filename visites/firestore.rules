rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The manager. Either mechanism grants it: the "owner" custom claim, or
    // simply signing in with one of these addresses. The claim needs a
    // service-account key and a script run, which is why the address is here
    // too — keep this list in step with OWNER_EMAILS in src/constants.js.
    function isOwner() {
      return request.auth != null
             && (request.auth.token.role == "owner"
                 || request.auth.token.email in ["elgarbimohamed.m@gmail.com"]);
    }

    match /visites/{visitId} {
      allow read, create, update: if request.auth != null;
      allow delete: if isOwner();
    }

    // Appointments: everyone signed in keeps the shared calendar up to date.
    // Cancelling one is routine work, so it does not wait for the manager —
    // but an employee can only remove an entry they created themselves.
    match /agenda/{eventId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.createdBy || isOwner());
    }

    // One document per phone that accepted notifications, keyed by its push
    // token. Only the Cloud Function reads them, through the admin SDK, which
    // rules do not apply to — so nobody here can enumerate the team's phones.
    match /tokens/{token} {
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
